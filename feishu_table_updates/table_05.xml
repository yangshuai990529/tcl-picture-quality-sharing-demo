<table id="doxcnRw5TPw3ftw6HpNwh1a2JMd"><colgroup><col width="247"/><col width="138"/><col width="328"/></colgroup><thead><tr><th vertical-align="top"><p id="doxcnRIc2ZNMt2ynqQvHnmcK1Mb">指标名称</p></th><th vertical-align="top"><p id="doxcnK4Og9ITsL1F8EFSHyu6K3b">目标</p></th><th vertical-align="top"><p id="doxcni0fL2eUSXkYWkt2ZeIUf2e">验收方式</p></th></tr></thead><tbody><tr><td vertical-align="top"><p id="doxcn4pgyOwRYjI9EHX7905Spxj">画质参数分享入口可达率</p></td><td vertical-align="top"><p id="doxcnrelOwkTtuwAqiAxTQFuCHW">待确认</p></td><td vertical-align="top"><p id="doxcniY9DRlkcf8r2dR65JA7j3f">在目标机型安全卫士首页检查入口展示、焦点可达和进入结果。</p></td></tr><tr><td vertical-align="top"><p id="doxcnVgRsOi7XYYdx4crh7ispRb">方案生成成功率</p></td><td vertical-align="top"><p id="doxcnzXoEaa4ARA536hqtROZpKd">待确认</p></td><td vertical-align="top"><p id="doxcnOStKcHgTNZJR0dGOWNZjug">使用不同信号类型和图效完成方案创建、参数读取和方案保存，统计成功结果。</p></td></tr><tr><td vertical-align="top"><p id="doxcnMQVzOL9QqEQY4HLe3Qm3cH">分享码导入成功率</p></td><td vertical-align="top"><p id="doxcnLDZe7duseBi1r4whBfuIlb">待确认</p></td><td vertical-align="top"><p id="doxcnSbaNU2sE9QweobuhBWL7Oc">使用有效、无效、失效和不兼容分享码进行导入测试，核对结果和提示。</p></td></tr><tr><td vertical-align="top"><p id="doxcnbGhtaa4K0qbkNlLO1MZ4Vh">方案应用成功率</p></td><td vertical-align="top"><p id="doxcnqgCH3Iv0EZfLY6oCAjkYWb">待确认</p></td><td vertical-align="top"><p id="doxcnnLNZqebYJAR68bcXV9bAGg">对创建方案、导入方案和自动备份方案执行应用，验证参数写入结果。</p></td></tr><tr><td vertical-align="top"><p id="doxcn48LiIMmrutW1JZf4H36Crf">应用失败可恢复率</p></td><td vertical-align="top"><p id="doxcnyF1pRI45YOSgpfUyUAkx2d">待确认</p></td><td vertical-align="top"><p id="doxcnMgAbaqy8pgtgcQ8DBQtbsg">模拟参数写入失败、中断、断网等场景，验证自动备份、回滚或恢复路径。</p></td></tr><tr><td vertical-align="top"><p id="doxcn39Xqlu3Idjz0JelAUxRcsf">主要流程遥控器可操作率</p></td><td vertical-align="top"><p id="doxcnaVR7nkR7n88rGE9p1pyjgb">100%覆盖核心路径</p></td><td vertical-align="top"><p id="doxcnijFBu6AApkZ7kvwjZoFzZb">不使用触摸操作，使用方向键、确认键和返回键完成入口、创建、导入、应用、删除和返回流程。</p></td></tr></tbody></table>