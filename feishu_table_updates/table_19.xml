<table id="doxcnmnfxsFYV7CmxaycV76DASc"><colgroup><col width="258"/><col width="480"/></colgroup><thead><tr><th vertical-align="top"><p id="doxcnOmFU42U0VJu8jznQTvGmMb">个人/隐私数据</p></th><th vertical-align="top"><p id="doxcnRuGVMCt4rqJ3bdNyksPEuf">数据的用途</p></th></tr></thead><tbody><tr><td vertical-align="top"><p id="doxcnUpjJV9M8NPcRQhwYrEz9Sd">方案名称</p></td><td vertical-align="top"><p id="doxcnUOa8lWV4PA24rV20lsIQog">用于用户在本机识别和管理方案；是否包含用户姓名、联系方式等个人信息需限制。</p></td></tr><tr><td vertical-align="top"><p id="doxcnTcIkvyZEPfrmyedgo1Ipvf">设备机型、软件版本、区域信息</p></td><td vertical-align="top"><p id="doxcnWZCePoyGdLWJVAwobTgKYc">用于分享方案兼容性判断和异常排查；具体是否上传云端待确认。</p></td></tr><tr><td vertical-align="top"><p id="doxcnIlvXA6S5DYkrO5C7FoL7yz">方案参数</p></td><td vertical-align="top"><p id="doxcnLFo0J9OzgWKdnhupQcVYTh">用于生成、保存、分享和应用画质调校结果；属于用户设置数据，需明确存储和传播范围。</p></td></tr><tr><td vertical-align="top"><p id="doxcnOH0Y2CGZZOGW11Wz9ek0Nh">分享码使用记录</p></td><td vertical-align="top"><p id="doxcnhKd68jLGOtWAuSoV2cOHUg">用于分享码有效期、撤回、次数限制和安全审计；字段和保留期限待确认。</p></td></tr><tr><td vertical-align="top"><p id="doxcnP33tIv3rRTksndA3AgV3bh">埋点信息</p></td><td vertical-align="top"><p id="doxcnZ8oO1wa4XuRduMfIhGutCh">用于统计功能使用和成功率；不得在未评审情况下采集可识别个人身份的信息。</p></td></tr></tbody></table>